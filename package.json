{
  "name": "sis-2-playwright",
  "version": "1.0.0",
  "description": "SIS 2: independent Playwright UI tests for Toolshop",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=3",
    "test:repeat": "playwright test --workers=3 --repeat-each=2",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "evidence": "node scripts/collect-evidence.mjs",
    "postinstall": "playwright install chromium"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
